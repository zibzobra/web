<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee" version="2.5">
  <servlet>
    <servlet-name>greetServlet</servlet-name>
    <servlet-class>NIC.WebGWT.server.GreetingServiceImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>greetServlet</servlet-name>
    <url-pattern>/driversmodule/greet</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>DriversModule.html</welcome-file>
  </welcome-file-list>
</web-app>